{
  "description": "Example plugin hooks (ZCode recommended layout under hooks/hooks.json).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/session-start.mjs"
            ],
            "timeoutMs": 5000,
            "statusMessage": "example-plugin: preparing session context…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/pre-tool-use.mjs"
            ],
            "timeoutMs": 3000,
            "statusMessage": "example-plugin: noting tool use…"
          }
        ]
      }
    ]
  }
}
